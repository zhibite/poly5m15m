###############################################################################
# Polymarket 5m/15m BTC/ETH covered-arbitrage bot — environment template
#
# Usage:
#   cp .env.example .env
#   fill in credentials and overrides (.env is gitignored)
#
# Precedence:
#   process env  >  .env  >  .env.docker  >  config.toml [ARB]  >  defaults
#
# All arbitrage settings use the ARB_ prefix. The complete list lives in
# src/config.py and config.toml.
###############################################################################

# ── Credentials ─────────────────────────────────────────────────────────
# Option A (recommended): L2 API credentials.
# All three are required for L2 signing.
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Option B: derive L2 credentials from the wallet at startup.
# WALLET_PRIVATE_KEY=0x...
# SIGNATURE_TYPE=0              # 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
# FUNDER_ADDRESS=               # required for SIG_TYPE=1/2: the wallet that
#                               # actually holds pUSD (else CLOB rejects with
#                               # "maker address not allowed")
# WALLET_ADDRESS is unused; the EOA is derived from the private key.

# ── Endpoints ───────────────────────────────────────────────────────────
GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com

# ── Mode (two-flag live gate) ───────────────────────────────────────────
# Live requires BOTH ARB_PAPER_TRADING=false AND ARB_LIVE_ENABLED=true.
ARB_PAPER_TRADING=true
ARB_LIVE_ENABLED=false
ARB_ENABLED=true
ARB_ASSETS=BTC,ETH

# ── Loop cadence ────────────────────────────────────────────────────────
ARB_TICK_S=0.25
ARB_DISCOVERY_S=5.0
ARB_MARKET_META_REFRESH_S=60.0
ARB_SETTLEMENT_POLL_S=3.0
ARB_STATUS_S=1.0

# ── Fees / edge ─────────────────────────────────────────────────────────
# Official taker fee: fee = shares * rate * p * (1-p); makers pay 0.
ARB_FEE_RATE=0.07
ARB_FEE_BUFFER_PCT=0.10
ARB_FEE_BUFFER_USD=0.01
ARB_MIN_EDGE_USD=0.02
ARB_MIN_EDGE_PCT=0.001
ARB_SAME_MARKET_MIN_EDGE_USD=0.02
ARB_SAME_MARKET_MIN_EDGE_PCT=0.001

# ── Strike / pairing ────────────────────────────────────────────────────
# auto = description strike when present, else Binance window-open price.
ARB_STRIKE_SOURCE=auto
# Reject a pair whose strikes are closer than this. Protects against a
# Binance-vs-Chainlink ordering flip.
ARB_MIN_STRIKE_GAP_BPS=5.0
ARB_STRIKE_SETTLE_S=2.0
ARB_STOP_OPEN_BEFORE_END_S=20.0
ARB_MIN_SECONDS_TO_END_S=15.0
ARB_MAX_QUOTE_AGE_S=1.5
ARB_MAX_BOOK_LEVELS=20
ARB_COOLDOWN_S=5.0

# ── Sizing / exposure ───────────────────────────────────────────────────
ARB_MAX_SHARES_PER_PAIR=100.0
ARB_MIN_SHARES_PER_PAIR=5.0
ARB_MAX_NOTIONAL_PER_PAIR=20.0
ARB_MAX_OPEN_POSITIONS=4
ARB_MAX_OPEN_NOTIONAL=80.0
ARB_MAX_DAILY_LOSS_USD=50.0
ARB_MAX_CONSECUTIVE_FAILURES=5
ARB_FAILURE_COOLDOWN_S=60.0

# ── Execution / leg risk ────────────────────────────────────────────────
# unwind = sell unmatched excess immediately (safe default)
# complete = first try to buy the shortfall on the failed leg
ARB_LEG_RISK_POLICY=unwind
# Live token balances settle 1-3 s after a FAK buy; this window covers it.
ARB_UNWIND_RETRIES=5
ARB_UNWIND_RETRY_DELAY_S=0.5
ARB_SELL_SLIPPAGE_PCT=2.0
ARB_USE_MARKET_WS=true
ARB_ALLOW_CROSS_MARKET=true
ARB_ALLOW_SAME_MARKET=true
# Four-leg complete set: pays exactly $2/set, strike-independent.
ARB_ALLOW_COMPLETE_SET=true
ARB_REQUIRE_SAME_RESOLUTION_SOURCE=true
# Paper already allows unknown sources for data collection. Keep this
# false in live so an unverifiable settlement source cannot trade.
ARB_ALLOW_UNKNOWN_RESOLUTION_SOURCE=false

# ── Paths ───────────────────────────────────────────────────────────────
# Defaults: <project>/data/arb.db, data/arb_status.json,
#           data/arb_emergency_stop.json
# POLYMARKET_DATA_DIR=./data
# ARB_DB_PATH=./data/arb.db
# ARB_STATUS_PATH=./data/arb_status.json
# ARB_KILLSWITCH_PATH=./data/arb_emergency_stop.json

# ── Dashboard (read-only, default port 8031) ────────────────────────────
ARB_WEB_ENABLED=true
ARB_WEB_HOST=0.0.0.0
ARB_WEB_PORT=8031
ARB_WEB_USERNAME=admin
# Set a password for any public deployment.
ARB_WEB_SESSION_TTL_S=604800
ARB_WEB_PASSWORD=

# ── Logging ─────────────────────────────────────────────────────────────
ARB_LOG_LEVEL=INFO
